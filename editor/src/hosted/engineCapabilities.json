{
  "apiVersion": 1,
  "executionRevision": 2,
  "validation": "shared Rust program validator",
  "channels": 2,
  "maxBlockFrames": 2048,
  "maxEventsPerBlock": 256,
  "sampleRate": { "min": 8000, "max": 384000 },
  "midiInputKinds": ["note on", "note off", "control change", "pitch bend"],
  "midiOutputKinds": ["note on", "note off", "control change"],
  "hostTimeline": true,
  "maxMusicalBeat": 1000000,
  "timelineContinuityTolerance": 1e-8,
  "maxHeldNotes": 2048,
  "maxMidiOutputEvents": 4096,
  "media": true,
  "nativeAnalysis": false,
  "maxOperations": 4096,
  "maxRegisters": 4096,
  "maxValues": 2048,
  "maxStates": 4096,
  "maxRepeatCapacity": 1024,
  "repeatPolicy": "explicit budget required for native repeats; legacy dynamic policy retained in standalone",
  "feedbackKinds": ["peak", "tempo", "parameters", "repeat exhaustion"]
}
