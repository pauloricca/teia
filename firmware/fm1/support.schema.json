{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FM-1 capability contract",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 2
    },
    "firmware": {
      "type": "string",
      "pattern": "^FM-1_[0-9]+$"
    },
    "reviewedOn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "reviewedSources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "supported",
              "partial",
              "unsupported",
              "unknown"
            ]
          },
          "since": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "verification": {
            "enum": [
              "unverified",
              "source reviewed",
              "host verified",
              "hardware verified"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "blockedInputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "blockedOutputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "drift": {
            "type": "object",
            "properties": {
              "webBehavior": {
                "type": "string",
                "minLength": 1
              },
              "firmwareBehavior": {
                "type": "string",
                "minLength": 1
              },
              "requiredWork": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "webBehavior",
              "firmwareBehavior",
              "requiredWork"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "category",
          "status",
          "since",
          "verification",
          "notes",
          "evidence"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "evidenceLog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "minLength": 1
          },
          "firmware": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "host verified",
              "hardware verified"
            ]
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "date",
          "firmware",
          "scope",
          "source"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "integer",
          "minimum": 1
        },
        "registers": {
          "type": "integer",
          "minimum": 1
        },
        "values": {
          "type": "integer",
          "minimum": 1
        },
        "states": {
          "type": "integer",
          "minimum": 1
        },
        "packageVersion": {
          "type": "integer",
          "minimum": 1
        },
        "operationBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "operations",
        "registers",
        "values",
        "states",
        "packageVersion",
        "operationBytes"
      ],
      "additionalProperties": false
    },
    "compiler": {
      "type": "object",
      "properties": {
        "opcodes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "oscillatorModes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "filterModes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "distortionModes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "arity": {
                "enum": [
                  1,
                  2,
                  3
                ]
              }
            },
            "required": [
              "id",
              "name",
              "arity"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "delay": {
          "type": "object",
          "properties": {
            "maxNodes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "maxSeconds": {
              "const": 1
            },
            "sampleRate": {
              "const": 44100
            },
            "storageBits": {
              "const": 16
            },
            "storageFractionBits": {
              "const": 12
            },
            "smoothingSamples": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "instruction": {
              "type": "integer",
              "minimum": 0
            },
            "legacyInstruction": {
              "type": "integer",
              "minimum": 0
            },
            "since": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "maxNodes",
            "maxSeconds",
            "sampleRate",
            "storageBits",
            "storageFractionBits",
            "smoothingSamples",
            "instruction",
            "legacyInstruction",
            "since"
          ],
          "additionalProperties": false
        },
        "repeat": {
          "type": "object",
          "properties": {
            "maxInstances": {
              "type": "integer",
              "minimum": 1
            },
            "maxContainers": {
              "type": "integer",
              "minimum": 1
            },
            "eventQueue": {
              "type": "integer",
              "minimum": 1
            },
            "since": {
              "type": "integer",
              "minimum": 1
            },
            "blockedOpcodes": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "uniqueItems": true
            }
          },
          "required": [
            "maxInstances",
            "maxContainers",
            "eventQueue",
            "since",
            "blockedOpcodes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "opcodes",
        "oscillatorModes",
        "filterModes",
        "distortionModes",
        "functions",
        "delay"
      ],
      "additionalProperties": false
    },
    "protocol": {
      "type": "object",
      "properties": {
        "packages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "headerBytes": {
                "type": "integer",
                "minimum": 12
              },
              "operationBytes": {
                "type": "integer",
                "minimum": 1
              },
              "operations": {
                "type": "integer",
                "minimum": 1
              },
              "registers": {
                "type": "integer",
                "minimum": 1
              },
              "values": {
                "type": "integer",
                "minimum": 1
              },
              "since": {
                "type": "integer",
                "minimum": 902
              }
            },
            "required": [
              "version",
              "headerBytes",
              "operationBytes",
              "operations",
              "registers",
              "values"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "since": {
                "type": "integer",
                "minimum": 1
              },
              "minimumPackageVersion": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "code",
              "name",
              "since",
              "minimumPackageVersion"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "liveEdit": {
          "type": "object",
          "properties": {
            "since": {
              "type": "integer",
              "minimum": 1
            },
            "probeCommand": {
              "type": "integer",
              "minimum": 1
            },
            "updateCommand": {
              "type": "integer",
              "minimum": 1
            },
            "maxUpdates": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "since",
            "probeCommand",
            "updateCommand",
            "maxUpdates"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "packages",
        "instructions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "firmware",
    "reviewedOn",
    "reviewedSources",
    "features",
    "evidenceLog",
    "limits",
    "compiler",
    "protocol"
  ],
  "additionalProperties": false
}
