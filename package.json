{
  "name": "teia",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "editor"
  ],
  "devDependencies": {
    "esbuild": "^0.27.7"
  },
  "scripts": {
    "prestart": "sh scripts/ensure-rust-wasm.sh",
    "predev": "sh scripts/ensure-rust-wasm.sh",
    "prepreview": "sh scripts/ensure-rust-wasm.sh",
    "ensure:wasm": "sh scripts/ensure-rust-wasm.sh",
    "dev": "npm --workspace editor run dev",
    "start": "npm run build && node scripts/serve-production.mjs",
    "preview": "npm --workspace editor run preview",
    "build:wasm": "sh scripts/build-rust-wasm.sh",
    "build:runtime": "tsc -p runtime/tsconfig.json && node scripts/build-runtime.mjs",
    "build": "npm --workspace editor run build",
    "typecheck": "npm --workspace editor run typecheck",
    "remix:video": "node scripts/remix-video-from-csv.mjs",
    "smoke:video-remix": "node scripts/smoke-video-remix.mjs",
    "smoke:dsp-ports": "node scripts/smoke-dsp-port-links.mjs",
    "benchmark:saved-patches": "node scripts/benchmark-saved-patches.mjs",
    "smoke:wasm-memory": "node scripts/smoke-wasm-memory.mjs",
    "fm1:support:check": "node scripts/fm1-support.mjs --check",
    "fm1:support:write": "node scripts/fm1-support.mjs --write",
    "pretypecheck": "npm run engine:capabilities:check && npm run fm1:support:check",
    "prebuild": "npm run engine:capabilities:check && npm run fm1:support:check",
    "fm1:install": "python3 scripts/fm1-install.py",
    "build:hosted": "node scripts/build-hosted.mjs",
    "build:hosted:conformance": "node scripts/build-hosted-conformance.mjs",
    "engine:capabilities:write": "node scripts/engine-capabilities.mjs --write",
    "engine:capabilities:check": "node scripts/engine-capabilities.mjs --check"
  }
}
